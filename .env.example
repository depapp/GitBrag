# GitHub token used server-side to query the GitHub GraphQL API.
# A fine-grained personal access token with NO extra permissions is enough
# (GitBrag only reads public data). Without it GitHub allows 60 requests/hour.
GITHUB_TOKEN=

# Public URL of the deployment, used for absolute links in share cards and metadata.
# Netlify's URL is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
